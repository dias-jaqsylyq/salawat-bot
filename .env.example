# Telegram bot token from @BotFather. NEVER commit the real value.
BOT_TOKEN=

# Challenge window (ISO dates, YYYY-MM-DD). Use the actual Gregorian dates
# for this year's Mawlid month (Rabi' al-Awwal), e.g. from a moon-sighting
# announcement or moonsighting.com.
CHALLENGE_START_DATE=2026-08-15
CHALLENGE_END_DATE=2026-09-13

# IANA timezone used for the daily reminder and "days left" calculations.
TIMEZONE=Asia/Hong_Kong

# 24h HH:mm time (in TIMEZONE) the daily reminder is sent.
REMINDER_TIME=20:00

# Path to the SQLite database file.
DB_PATH=./data/salawat.db
