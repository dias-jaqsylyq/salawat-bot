# Telegram bot token from @BotFather. NEVER commit the real value.
BOT_TOKEN=

# Challenge window (ISO dates, YYYY-MM-DD). Use the actual Gregorian dates
# for this year's Mawlid month (Rabi' al-Awwal), e.g. from a moon-sighting
# announcement or moonsighting.com.
CHALLENGE_START_DATE=2026-08-15
CHALLENGE_END_DATE=2026-09-13

# IANA timezone used for the daily reminder and "days left" calculations.
TIMEZONE=Asia/Hong_Kong

# 24h HH:mm time (in TIMEZONE) the daily reminder is sent.
REMINDER_TIME=20:00

# Path to the SQLite database file.
DB_PATH=./data/salawat.db

# Port the HTTP API listens on. Railway injects PORT automatically in production.
PORT=3000

# Allowed CORS origin(s) for the Mini App frontend. Comma-separated for multiple.
# Placeholder wildcard for now — tighten to the real Vercel domain once deployed,
# e.g. https://salawat-miniapp.vercel.app
CORS_ORIGIN=*

# Real HTTPS URL of the deployed Mini App (Vercel), used to configure the bot's
# chat menu button. Placeholder until the frontend is deployed.
MINI_APP_URL=https://example.com/REPLACE_WITH_VERCEL_URL

# t.me deep link used for the daily reminder's inline button (works today,
# independent of MINI_APP_URL/Vercel deployment status).
MINI_APP_DEEP_LINK=https://t.me/salawat_challenge_bot/challenge

# Max age (seconds) a Telegram initData payload is accepted before being
# rejected as stale/replayed.
INIT_DATA_MAX_AGE_SECONDS=86400
